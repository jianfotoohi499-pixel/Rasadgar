{
  "expo": {
    "name": "دیدبان ژیان",
    "slug": "didban-zhian",
    "version": "1.4.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "ir.zhian.didban",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/rasadgar-icon.png",
        "backgroundColor": "#06132e"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "description": "دستیار هوشمند مالی، اقتصادی و موقعیت مکانی"
    },
    "icon": "./assets/rasadgar-icon.png",
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "برای نمایش موقعیت فعلی و مختصات GPS، اجازه مکان‌یابی هنگام استفاده از برنامه لازم است."
        }
      ]
    ]
  }
}
